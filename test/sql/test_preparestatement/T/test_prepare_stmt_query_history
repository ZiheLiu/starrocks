-- name: test_prepare_stmt_query_history @sequential

admin set frontend config ("enable_collect_query_detail_info" = "true");

create database db_${uuid0};
use db_${uuid0};

CREATE TABLE __row_util_base (
  k1 bigint NULL
) ENGINE=OLAP
DUPLICATE KEY(`k1`)
DISTRIBUTED BY HASH(`k1`) BUCKETS 32
PROPERTIES (
    "replication_num" = "1"
);
insert into __row_util_base select generate_series from TABLE(generate_series(0, 10000 - 1));
insert into __row_util_base select * from __row_util_base;
insert into __row_util_base select * from __row_util_base;
insert into __row_util_base select * from __row_util_base;
insert into __row_util_base select * from __row_util_base;

CREATE TABLE __row_util (
  idx bigint NULL
) ENGINE=OLAP
DUPLICATE KEY(`idx`)
DISTRIBUTED BY HASH(`idx`) BUCKETS 32
PROPERTIES (
    "replication_num" = "1"
);
insert into __row_util select row_number() over() as idx from __row_util_base;


CREATE TABLE t1 (
    k1 bigint NULL,
    c_1 int,
    c_2 int,
    c_3 int,
    c_4 int
) ENGINE=OLAP
DUPLICATE KEY(`k1`)
DISTRIBUTED BY HASH(`k1`) BUCKETS 32
PROPERTIES (
    "replication_num" = "1"
);

insert into t1 
select
    idx, idx + 1, idx + 2, idx + 3, idx + 4
from __row_util;

function: execute_by_prepared_stmt_conn("use db_${uuid0}")
function: execute_by_prepared_stmt_conn("set enable_profile = true")
function: execute_by_prepared_stmt_conn("set enable_async_profile = false")

-- Enable profile

function: execute_prepared_stmt("SELECT k1, c_1, c_2, c_3, c_4 FROM t1 WHERE (c_1 = ? AND c_2 = ?) OR (c_3 = ? AND c_4 = ?)", [100, 101, 102, 103])
-- Get execute stmt query detail.
[UC]function: query_id=execute_by_prepared_stmt_conn("SELECT last_query_id()")
[UC]function: execute_detail=get_query_detail_or_timeout("${query_id}")
WITH w1 as (SELECT parse_json('${execute_detail}') detail)
SELECT 
    detail->'command' AS command,
    regexp_extract(detail->'profile' , 'Query ID: (.*?)\n', 1) = '${query_id}' AS is_correct_query_id_from_profile
FROM w1;
WITH w1 as (SELECT parse_json('${execute_detail}') detail)
SELECT 
    detail->'sql' as query
FROM w1;
-- Get prepare stmt query detail.
[UC]prepared_stmt_id=WITH w1 as (SELECT parse_json('${execute_detail}') detail) SELECT detail->'preparedStmtId' preparedStmtId FROM w1;
[UC]function: prepare_detail=get_prepared_stmt_query_detail_or_timeout(${prepared_stmt_id})
WITH w1 as (
    SELECT parse_json('${prepare_detail}') detail
)
SELECT 
    detail->'command' AS command,
    detail->'queryId' != '${query_id}' AS is_correct_query_id,
    detail->'profile' as profile
FROM w1;
WITH w1 as (
    SELECT parse_json('${prepare_detail}') detail
)
SELECT 
    detail->'sql' as query
FROM w1;

-- Disable audit_execute_stmt

function: execute_by_prepared_stmt_conn("set audit_execute_stmt = false")

function: execute_prepared_stmt("SELECT k1, c_1, c_2, c_3, c_4 FROM t1 WHERE (c_1 = ? AND c_2 = ?) OR (c_3 = ? AND c_4 = ?)", [100, 101, 102, 103])
[UC]function: check_prepared_stmt_query_detail()

admin set frontend config ("enable_collect_query_detail_info" = "false");
drop database db_${uuid0} FORCE;

